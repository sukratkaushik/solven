# =========================================================================
# Solven (Insolvenz-Wächter) Environment Configuration Template
# =========================================================================

# Supabase Cloud Database & Authentication (Frankfurt / EU)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Commercial Register & Company Search Proxy (handelsregister.ai or national registry proxy)
HANDELSREGISTER_API_KEY=your_commercial_register_api_key

# Stripe B2B Subscriptions & Invoicing (SEPA Lastschrift & Credit Card)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...

# Transactional Court Alert & Reset Password Emails (Resend)
RESEND_API_KEY=re_...

# Base Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Secret bearer token to trigger daily 07:00 AM Court Sentinel cron
CRON_SECRET=your_cron_secret_token
